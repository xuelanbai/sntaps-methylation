# Copy to config.env and edit. Do not commit config.env.

PROJECT_ROOT=/path/to/snTAPS_methylation
SCRIPT_ROOT=/path/to/this/repository/batches/snTAPS-FL-1/old-server/03_scripts

CONDA_INIT=/path/to/miniconda3/etc/profile.d/conda.sh
QC_ENV=snTAPS_qc
ALIGN_ENV=snTAPS_align
ANALYSIS_ENV=snTAPS_analysis

REFERENCE_FASTA=/path/to/pig/genome.fa
PROMOTER_BED=/path/to/pig/gene_regions/pig_promoter_TSS_1.5kb.bed
BAM_LIST=/path/to/all_64_bam.list
STRICT2_WHITELIST=/path/to/strict2_CB.whitelist.txt
GLOBAL_QC=/path/to/strict2_cells.global_qc.tsv

PROMOTER_MATRIX_PREFIX=/path/to/output/snTAPS-FL-1.strict2.promoter_TSS_1.5kb
P7_NO01_MATRIX=/path/to/snTAPS-FL-1.P7_no01.promoter_TSS_1.5kb.region_counts.tsv.gz
FINAL_UMAP_OUTDIR=/path/to/output/P7_no01_promoter_residual_dropPC1_smooth100
FINAL_UMAP_PREFIX=snTAPS-FL-1.P7_promoter_residual_all_dropPC1_smooth100

THREADS=32
