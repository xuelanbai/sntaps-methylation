#!/bin/bash
#CSUB -J all100kb_core5000_seurat_qcreg
#CSUB -q c02
#CSUB -n 16
#CSUB -R 'span[hosts=1]'
#CSUB -cwd /share/org/YZWL/yzwl_wujx/Projects/snTAPS_methylation
#CSUB -o 09_logs/region_umap_paper/filteredCB_promoter_100kb_rescue/all100kb_core5000_seurat_qcreg.out
#CSUB -e 09_logs/region_umap_paper/filteredCB_promoter_100kb_rescue/all100kb_core5000_seurat_qcreg.err

set -euo pipefail
cd /share/org/YZWL/yzwl_wujx/Projects/snTAPS_methylation

/share/org/YZWL/yzwl_wujx/.conda/envs/snTAPS_analysis/bin/python 03_scripts/34_umap_100kb_qcregress_fast.py \
  --global-qc "08_qc_summary/final_single_sample/cell_filter_balanced_core/snTAPS-FL-1.balanced_core5000.global_per_cb.tsv" \
  --bin-counts "08_qc_summary/final_single_sample/snTAPS-FL-1.all_technical_merged.bin_counts.tsv.gz" \
  --outdir "08_qc_summary/final_single_sample/region_umap_paper/filteredCB_promoter_100kb_rescue/all100kb_core5000_seurat_qcreg" \
  --prefix "snTAPS-FL-1.all100kb_core5000_seurat_qcreg" \
  --mode seurat_norm \
  --qc-keys reads_used,modified_rate \
  --min-reads 0 \
  --min-covered-calls 0 \
  --min-covered-bins 0 \
  --cellbin-min-cov 1 \
  --max-cells 200000 \
  --min-bin-cells "1250" \
  --top-variable-bins "1000" \
  --n-pcs 30 \
  --n-clusters 8 \
  --n-jobs 16 \
  --seed 1
