#!/bin/bash
#CSUB -J umap_E_strict
#CSUB -q c02
#CSUB -n 16
#CSUB -o 09_logs/umap_compare_50k/E_D_strict_qc.out
#CSUB -e 09_logs/umap_compare_50k/E_D_strict_qc.err

set -euo pipefail

cd /share/org/YZWL/yzwl_wujx/Projects/snTAPS_methylation

source /share/apps/anaconda3/etc/profile.d/conda.sh
conda activate snTAPS_analysis

python3 03_scripts/34_umap_100kb_modes_pc_regress_qc.py \
  --global-qc 08_qc_summary/final_single_sample/snTAPS-FL-1.all_technical_merged.global_per_cb.tsv \
  --bin-counts 08_qc_summary/final_single_sample/snTAPS-FL-1.all_technical_merged.bin_counts.tsv.gz \
  --outdir 08_qc_summary/final_single_sample/umap_compare_50k/E_D_strict_qc \
  --prefix snTAPS-FL-1.E_D_strict_qc_50k \
  --mode residual \
  --max-cells 50000 \
  --min-reads 50000 \
  --min-covered-calls 100000 \
  --min-covered-bins 5000 \
  --cellbin-min-cov 10 \
  --min-bin-cells 5000 \
  --top-variable-bins 1000 \
  --n-pcs 30 \
  --n-clusters 8 \
  --n-jobs 16
