#!/bin/bash
#CSUB -J umap_B_norm
#CSUB -q c02
#CSUB -n 16
#CSUB -o 09_logs/umap_compare_50k/B_seurat_norm_100kb.out
#CSUB -e 09_logs/umap_compare_50k/B_seurat_norm_100kb.err

set -euo pipefail
cd /share/org/YZWL/yzwl_wujx/Projects/snTAPS_methylation
source /share/apps/anaconda3/etc/profile.d/conda.sh
conda activate snTAPS_analysis

python3 03_scripts/33_umap_100kb_modes.py \
  --global-qc 08_qc_summary/final_single_sample/snTAPS-FL-1.all_technical_merged.global_per_cb.tsv \
  --bin-counts 08_qc_summary/final_single_sample/snTAPS-FL-1.all_technical_merged.bin_counts.tsv.gz \
  --outdir 08_qc_summary/final_single_sample/umap_compare_50k/B_seurat_norm_100kb \
  --prefix snTAPS-FL-1.B_seurat_norm_100kb_50k \
  --mode seurat_norm \
  --max-cells 50000 \
  --min-reads 20000 \
  --min-covered-calls 50000 \
  --min-covered-bins 2000 \
  --cellbin-min-cov 5 \
  --min-bin-cells 300 \
  --top-variable-bins 2000 \
  --n-pcs 30 \
  --n-clusters 8 \
  --n-jobs 16
